# Supabase: Project Settings → API (create the project in the Mumbai region, ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic Console → API keys
ANTHROPIC_API_KEY=

# Comma-separated emails allowed to sign in (the recruiter)
RECRUITER_EMAILS=

# Random string; Vercel sends it to the daily data-deletion job
CRON_SECRET=

# Days to keep CVs after a role is closed
RETENTION_DAYS=180
